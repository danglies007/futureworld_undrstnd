    c. Mission, Vision and Values:
      ```json
      {
        "url": "[about_page_url]",
        "actions": [
          {"type": "extract_text", "selector": ".mission, .vision, .values, section:contains('Mission'), section:contains('Vision'), section:contains('Values')"},
          {"type": "screenshot", "path": "mission_vision_values.png"},
          {"type": "evaluate", "javascript": `
            const findSection = (keyword) => {
              const elements = Array.from(document.querySelectorAll('h1, h2, h3, h4, p, div, section'));
              const section = elements.find(el => 
                el.textContent.toLowerCase().includes(keyword.toLowerCase())
              );
              
              if (!section) return null;
              
              // Get the parent section or the element itself
              const sectionElement = section.closest('section') || section;
              return sectionElement.textContent.trim();
            };
            
            return {
              mission: findSection('mission'),
              vision: findSection('vision'),
              values: findSection('values')
            };
          `}
        ]
      }
