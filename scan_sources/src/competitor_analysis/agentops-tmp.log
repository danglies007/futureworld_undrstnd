          {"type": "extract_text", "selector": "section:contains('About'), div:contains('Overview'), .company-profile, .about-us"},
          {"type": "screenshot", "path": "company_overview.png"},
          {"type": "evaluate", "javascript": `
            const sections = [
              ...document.querySelectorAll('h1, h2, h3, h4, h5, h6'),
            ].filter(h => 
              h.textContent.toLowerCase().includes('about') || 
              h.textContent.toLowerCase().includes('overview') || 
              h.textContent.toLowerCase().includes('profile') ||
              h.textContent.toLowerCase().includes('company')
            );
            
            return sections.map(section => {
              let content = '';
              let element = section.nextElementSibling;
              
              while (element && !['H1', 'H2', 'H3', 'H4', 'H5', 'H6'].includes(element.tagName)) {
                content += element.textContent + ' ';
                element = element.nextElementSibling;
              }
              
              return {
                heading: section.textContent.trim(),
                content: content.trim()
              };
            });
          `}
        ]
      }
