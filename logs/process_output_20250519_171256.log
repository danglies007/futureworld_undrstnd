ird_order_implications": [\n    {\n      "implication_id": "TOI-001",\n      "implication_order": 3,\n      "implication_title": "Programmable Societies: Rise of Autonomous Governance Systems",\n      "implication_description": "The convergence of decentralized autonomous organizations (DAOs), AI-driven policymaking, and distributed ledger technology could give rise to \'programmable societies\'—social and economic systems in which governance, economic rules, and social contracts are dynamically enacted through code. Power shifts from centralized states or corporations to self-adjusting systems governed by algorithmic consensus, potentially transforming concepts of regulation, law, citizenship, and social contract. This could disintermediate governments, disrupt traditional regulatory approaches, and give rise to new forms of digital identity, value exchange, and distributed social welfare.",\n      "category": {\n        "name": "Paradigm Shift – Socio-technical Order",\n        "description": "Transformation in how societies self-organize, govern, and allocate value, driven by technological convergence."\n      },\n      "parent_implications_ids": ["SOI-DAOs","SOI-AI-Laws","SOI-DLT-Economy"],\n      "parent_implications_names": ["Decentralized Autonomous Organizations restructure firms","AI-driven legal/policy decisionmaking","Distributed ledger underpins new economic models"],\n      "parent_market_forces_ids": ["MF-Decentralization","MF-Digital Trust","MF-Automation"],\n      "parent_market_forces_names": ["Widespread push for decentralization","Erosion of central trust / rise of digital trust mechanisms","Relentless automation of administrative and decision-making tasks"],\n      "impact_level": "Transformational/Systemic",\n      "time_horizon": "7–15 years",\n      "uncertainty": "High—relies on technological, societal, and regulatory convergence",\n      "scenario_development": [\n        "Widespread adoption of DAOs challenges state monopoly on governance i