nce consulting\", \"Risk management advisory\"],\n      \"related_mega_trends\": [\"Geopolitical shifts\", \"Regulatory complexity\"],\n      \"possible_signals\": [\"Increased demand for compliance and risk consulting\"],\n      \"possible_structural_shifts\": [\"Greater integration of legal and regulatory expertise in consulting\"],\n      \"implications_on_future_of_sector\": [\n        \"Consulting firms must invest in regulatory expertise and scenario planning.\",\n        \"Clients will increasingly rely on consultants for navigating complex regulatory landscapes.\"\n      ],\n      \"sources\": [\n        {\n          \"title\": \"Management Consulting Services Global Market Report 2025\",\n          \"url\": \"https://www.thebusinessresearchcompany.com/report/management-consulting-services-global-market-report\",\n          \"date\": \"January 2025\"\n        }\n      ]\n    },\n    {\n      \"raw_market_force_id\": \"TBRC-2025-004\",\n      \"raw_market_force_name\": \"Environmental Collaboration and Sustainability Initiatives\",\n      \"raw_description\": \"Global collaboration for environmental protection and the increasing focus on sustainability are shaping the management consulting market. Consulting firms are being called upon to advise on environmental and sustainability strategies, regulatory compliance, and governance. This force is driven by societal and regulatory pressures for sustainable business practices and is expected to persist and grow in importance.\",\n      \"key_terms\": [\"environmental collaboration\", \"sustainability\", \"regulatory compliance\", \"governance\", \"ESG\"],\n      \"mentioned_entities\": [\"Accenture\", \"Environmental Resources Management (ERM)\"],\n      \"raw_findings\": [\n        {\n          \"content\": \"Increasing focus on customer satisfaction and global collaboration for environmental protection are driving market growth.\",\n          \"source_url\": \"https://www.thebusinessresearchcompany.com/report/m