pe': 'string'}, 'title': 'Parent Market Forces Names', 'type': 'array'}, 'impact_level': {'description': 'Estimated impact level (High, Medium, Low) - with a rationale', 'title': 'Impact Level', 'type': 'string'}, 'time_horizon': {'description': 'Expected time frame for manifestation - with a rationale', 'title': 'Time Horizon', 'type': 'string'}, 'uncertainty': {'description': 'Level of uncertainty (High, Medium, Low) - with a rationale', 'title': 'Uncertainty', 'type': 'string'}, 'scenario_development': {'description': 'For 2nd and 3rd order implications, Mini-scenarios illustrating how the implication might manifest', 'items': {'type': 'string'}, 'title': 'Scenario Development', 'type': 'array'}, 'indicators': {'description': 'For 2nd and 3rd order implications, Key indicators or signals that would suggest the implication or scenario is emerging', 'items': {'type': 'string'}, 'title': 'Indicators', 'type': 'array'}, 'alternative_futures': {'description': 'For 3rd order implications, Alternative futures based on different manifestations', 'items': {'type': 'string'}, 'title': 'Alternative Futures', 'type': 'array'}, 'wild_card_events': {'description': 'For 3rd order implications, Wild card or black swan events that could accelerate or trigger the shift', 'items': {'type': 'string'}, 'title': 'Wild Card Events', 'type': 'array'}, 'business_relevance': {'description': 'Specific relevance to the business if provided', 'items': {'type': 'string'}, 'title': 'Business Relevance', 'type': 'array'}, 'strategic_considerations': {'description': 'Strategic considerations arising from this implication, provide more than one', 'items': {'type': 'string'}, 'title': 'Strategic Considerations', 'type': 'array'}, 'potential_opportunities': {'description': 'Potential opportunities arising, provide more than one', 'items': {'type': 'string'}, 'title': 'Potential Opportunities', 'type': 'array'}, 'potential_threats': {'description': 'Potential threats or challenges arising, provide more than one', 'items': {'type': 'string'}, 'title': 'Potential Threats', 'type': 'array'}}, 'required': ['implication_id', 'implication_order', 'implication_title', 'implication_description', 'category', 'impact_level', 'time_horizon', 'uncertainty'], 'title': 'Implication', 'type': 'object'}, 'ImplicationCategory': {'description': 'Category for grouping implications.', 'properties': {'name': {'description': 'Name of the implication category', 'title': 'Name', 'type': 'string'}, 'description': {'description': 'Description of this category', 'title': 'Description', 'type': 'string'}}, 'required': ['name', 'description'], 'title': 'ImplicationCategory', 'type': 'object'}}, 'properties': {'implications_report_title': {'description': 'Title of the implications analysis report', 'title': 'Implications Report Title', 'type': 'string'}, 'implications_report_generation_date': {'description': 'Report generation date', 'title': 'Implications Report Generation Date', 'type': 'string'}, 'topic': {'description': 'The topic the implications analysis is focused on', 'title': 'Topic', 'type': 'string'}, 'business_context': {'anyOf': [{'type': 'string'}, {'type': 'null'}], 'default': None, 'description': 'Business context if provided', 'title': 'Business Context'}, 'implications_report_executive_summary': {'description': 'Concise executive summary of key findings', 'title': 'Implications Report Executive Summary', 'type': 'string'}, 'implications_report_methodology': {'description': 'Description of the methodology used for implications analysis', 'title': 'Implications Report Methodology', 'type': 'string'}, 'first_order_implications': {'description': 'List of first-order implications recieved from the analyse_first_order_implications task', 'items': {'$ref': '#/$defs/Implication'}, 'title': 'First Order Implications', 'type': 'array'}, 'second_order_implications': {'description': 'List of second-order implications recieved from the analyse_second_order_implications task', 'items':